# --- LAN attachment -----------------------------------------------------------
# Host NIC that is connected to the LAN (see `ip -br addr`).
PARENT_INTERFACE=end0
# Your LAN subnet and router.
LAN_SUBNET=192.168.1.0/24
LAN_ROUTER=192.168.1.1
# The gateway's own IP on the LAN. Pick an unused address OUTSIDE your
# router's DHCP pool (or reserve it in the router).
GATEWAY_IP=192.168.1.250
# macvlan (default) gives the container its own MAC. Use ipvlan if the parent
# interface is Wi-Fi or the switch/AP only allows one MAC per port.
LAN_DRIVER=macvlan

# --- Behaviour ---------------------------------------------------------------
# true  = block client traffic while WARP is down (no leaks)
# false = fall back to the normal internet connection while WARP is down
KILL_SWITCH=false
# Run a DNS forwarder on GATEWAY_IP:53 that resolves via WARP.
ENABLE_DNS=true
DNS_UPSTREAMS=1.1.1.1 1.0.0.1
# Optional WARP+ license key.
WARP_LICENSE_KEY=
# Optional endpoint override, e.g. 162.159.192.1:2408 (default: from profile).
WARP_ENDPOINT=
# Health check every HEALTH_INTERVAL seconds; WARP is considered down after
# HEALTH_FAILURES consecutive failures.
HEALTH_INTERVAL=10
HEALTH_FAILURES=3
